#include <stdio.h>
#include <math.h>

/* Способ 2: сумма N членов ряда Маклорена */
double sin_n(double x, int N)
{
    double sum = 0;
    double term = x;   /* первый член ряда: x */
    int k;

    for (k = 1; k <= N; k++)
    {
        sum = sum + term;
        /* переход к следующему члену: умножаем на -x*x / ((2k)*(2k+1)) */
        term = term * (-1) * x * x / ((2 * k) * (2 * k + 1));
    }
    return sum;
}

/* Способ 3: суммируем, пока очередной член по модулю не станет меньше eps */
double sin_eps(double x, double eps)
{
    double sum = 0;
    double term = x;
    int k = 1;

    while (fabs(term) >= eps)
    {
        sum = sum + term;
        term = term * (-1) * x * x / ((2 * k) * (2 * k + 1));
        k++;
    }
    return sum;
}

int main()
{
    double x, eps;
    double s1, s2, s3;
    int n;

    printf("Введите x: ");
    scanf("%lf", &x);
    printf("Введите точность eps: ");
    scanf("%lf", &eps);

    /* Способ 1: стандартная библиотека */
    s1 = sin(x);
    /* Способ 2: ряд из 10 членов */
    s2 = sin_n(x, 10);
    /* Способ 3: ряд с заданной точностью */
    s3 = sin_eps(x, eps);

    printf("\nsin(%g)\n", x);
    printf("1) sin из math.h:      %.10f\n", s1);
    printf("2) sin_n (N = 10):     %.10f\n", s2);
    printf("3) sin_eps (eps=%g): %.10f\n", eps, s3);

    printf("\nОтклонение от sin из math.h:\n");
    printf("sin_n:   %+.4e\n", s1 - s2);
    printf("sin_eps: %+.4e\n", s1 - s3);

    /* Таблица: как меняется результат при росте N */
    printf("\n  N |  sin_N  | отклонение\n");
    for (n = 1; n <= 10; n++)
    {
        s2 = sin_n(x, n);
        printf("%3d | %.4f | %+.4e\n", n, s2, s1 - s2);
    }

    return 0;
}

