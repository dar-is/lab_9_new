#include <stdio.h>
#include <math.h>

// 1. Определение первой функции F1(x)
double fa(double x) {
    double y;
    if (x <= 3) {
        y = x * x - 3 * x + 9;
    } else {
        y = 1.0 / (x * x * x + 3);
    }
    return y;
}

// Определение второй функции F2(x)
double fb(double x) {
    double y;
    y = x * exp(sin(x * x));
    return y;
}

int main() {
    double x;
    int choice;

    // Запрос значения x у пользователя
    printf("Введите значение x: ");
    if (scanf("%lf", &x) != 1) {
        return 1;
    }

    // 2. Вывод значений функций для заданного x
    printf("\n--- Значения функций ---\n");
    printf("fa(x) = %lf, fb(x) = %lf\n", fa(x), fb(x));

    // 3. Вывод произведения, разности квадратов и удвоенной суммы с пояснениями
    // Разность квадратов: (fa)^2 - (fb)^2
    // Удвоенная сумма: 2 * (fa + fb)
    printf("\n--- Вычисления ---\n");
    printf("произведение: %lf\n", fa(x) * fb(x));
    printf("разность квадратов: %lf\n", (fa(x) * fa(x)) - (fb(x) * fb(x)));
    printf("удвоенная сумма: %lf\n", 2 * (fa(x) + fb(x)));

    // 4. Меню для выбора расчета
    printf("\n--- МЕНЮ ---\n");
    printf("1. Рассчитать значение fa(x)\n");
    printf("2. Рассчитать значение fb(x)\n");
    printf("3. Рассчитать произведение\n");
    printf("4. Рассчитать разность квадратов\n");
    printf("5. Рассчитать удвоенную сумму\n");
    printf("Выберите пункт меню (от 1 до 5): ");
    
    if (scanf("%d", &choice) != 1) {
        return 1;
    }

    printf("\nРезультат: ");
    switch (choice) {
        case 1:
            printf("fa(x) = %lf\n", fa(x));
            break;
        case 2:
            printf("fb(x) = %lf\n", fb(x));
            break;
        case 3:
            printf("произведение = %lf\n", fa(x) * fb(x));
            break;
        case 4:
            printf("разность квадратов = %lf\n", (fa(x) * fa(x)) - (fb(x) * fb(x)));
            break;
        case 5:
            printf("удвоенная сумма = %lf\n", 2 * (fa(x) + fb(x)));
            break;
        default:
            printf("Ошибка: неверный пункт меню!\n");
    }

    return 0;
}

