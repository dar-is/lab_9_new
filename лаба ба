#include <stdio.h>
#include <math.h>

/* Площадь треугольника по трем сторонам (формула Герона) */
float area_triangle(float a, float b, float c)
{
    float p, s;
    p = (a + b + c) / 2;
    s = sqrt(p * (p - a) * (p - b) * (p - c));
    return s;
}

/* Вывод определения фигуры и проверка сторон */
/* a - боковая сторона, b - основание (в символах) */
void print_definition(int a, int b)
{
    int i;
    int left = 0;     /* символов на левой стороне */
    int right = 0;    /* символов на правой стороне */
    int bottom = b;   /* символов на основании */

    printf("Равнобедренный треугольник - это треугольник,\n");
    printf("у которого две стороны равны, а углы при основании равны.\n");

    /* левая и правая стороны: по одному символу в каждой строке рисунка */
    for (i = 1; i <= a; i++)
    {
        left = left + 1;
        right = right + 1;
    }

    printf("Символов на левой стороне: %d\n", left);
    printf("Символов на правой стороне: %d\n", right);
    printf("Символов на основании: %d\n", bottom);

    if (left == right)
    {
        printf("треугольник равнобедренный\n");
    }
    else
    {
        printf("треугольник не равнобедренный\n");
    }
}

/* Рисование треугольника символом '*' */
/* a - боковая сторона (число строк); в строке номер i будет 2*i-1 звездочек */
/* основание (последняя строка) = 2*a-1 звездочек, боковые стороны = a звездочек */
void draw_triangle(int a)
{
    int i, j;

    for (i = 1; i <= a; i++)
    {
        /* пробелы слева: по два на каждую строку, чтобы фигура была по центру */
        for (j = 1; j <= 2 * (a - i); j++)
        {
            printf(" ");
        }
        /* звездочки через пробел: в строке i их 2*i-1 */
        for (j = 1; j <= 2 * i - 1; j++)
        {
            printf("* ");
        }
        printf("\n");
    }
}

int main()
{
    int choice;
    int a, b;

    printf("Фигура: равнобедренный треугольник\n");
    printf("Введите боковую сторону a (целое число): ");
    scanf("%d", &a);

    /* проверка: сторона должна быть положительной */
    while (a <= 0)
    {
        printf("Сторона должна быть больше нуля. Введите заново: ");
        scanf("%d", &a);
    }

    /* основание: на рисунке оно всегда длиннее боковой стороны */
    b = 2 * a - 1;
    printf("Основание b = %d\n", b);

    do
    {
        printf("\nМеню:\n");
        printf("1) Рассчитать площадь\n");
        printf("2) Вывести определение фигуры\n");
        printf("3) Нарисовать фигуру\n");
        printf("0) Выход\n");
        printf("Ваш выбор: ");
        scanf("%d", &choice);

        if (choice == 1)
        {
            printf("Площадь = %.2f\n", area_triangle(a, a, b));
        }
        else if (choice == 2)
        {
            print_definition(a, b);
        }
        else if (choice == 3)
        {
            draw_triangle(a);
        }
        else if (choice != 0)
        {
            printf("Неверный пункт меню!\n");
        }
    } while (choice != 0);

    return 0;
}
