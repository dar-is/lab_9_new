#include <stdio.h>
#include <math.h>
#include <locale.h>

double sin_n(double x, int N)
{
    double sum = 0;
    double term = x;
    int k;

    for (k = 1; k < N; k++)
    {
        sum = sum + term;
        term = term * (-1) * x * x / ((2 * k) * (2 * k + 1));
    }
    return sum;
}

double sin_eps(double x, double eps)
{
    double sum = 0;
    double term = x;
    int k = 1;

    while (fabs(term) >= eps)
    {
        sum = sum + term;
        term = term * (-1) * x * x / ((2 * k) * (2 * k + 1));
        k++;
    }
    return sum;
}

/* форматирует число и заменяет точку на запятую */
static void fmt(char *buf, size_t sz, const char *f, double v)
{
    char *p;
    snprintf(buf, sz, f, v);
    for (p = buf; *p; p++)
        if (*p == '.') *p = ',';
}

int main()
{
    double x, eps;
    double s1, s2, s3;
    int n;
    char a[32], b[32], c[32];

    setlocale(LC_CTYPE, "Russian");   /* только кириллица; числа вводим через точку */

    printf("Введите x: ");
    scanf("%lf", &x);
    printf("Введите точность eps: ");
    scanf("%lf", &eps);

    s1 = sin(x);
    s2 = sin_n(x, 10);
    s3 = sin_eps(x, eps);

    printf("\n1) sin из math.h:      %.10f\n", s1);
    printf("2) sin_n (N = 10):     %.10f\n", s2);
    printf("3) sin_eps (eps=%g): %.10f\n", eps, s3);

    printf("\nОтклонение от sin из math.h:\n");
    printf("sin_n:   %+.4e\n", s1 - s2);
    printf("sin_eps: %+.4e\n", s1 - s3);

    /* Итоговая таблица — как на фото */
    fmt(c, sizeof c, "%.2f", x);
    printf("\nsin(%s)\n", c);
    printf("  N |  sin_N |  отклонение\n\n");
    for (n = 1; n <= 20; n++)
    {
        s2 = sin_n(x, n);
        fmt(a, sizeof a, "%.4f", s2);
        fmt(b, sizeof b, "%+.4e", s1 - s2);
        printf("%3d | %s | %s\n", n, a, b);
    }

    return 0;
}
