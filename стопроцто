#include <stdio.h>
#include <math.h>

/* Площадь треугольника по трем сторонам (формула Герона) */
float area_triangle(float a, float b, float c)
{
    float p, s;
    p = (a + b + c) / 2;
    s = sqrt(p * (p - a) * (p - b) * (p - c));
    return s;
}

/* Проверка существования треугольника */
int triangle_exists(int a, int b, int c)
{
    if (a <= 0 || b <= 0 || c <= 0)
        return 0;
    if (a + b <= c || a + c <= b || b + c <= a)
        return 0;
    return 1;
}

/* Вывод определения фигуры и проверка сторон */
void print_definition(int a, int b)
{
    int i;
    int left = 0;
    int right = 0;
    int bottom = b;

    printf("Равнобедренный треугольник - это треугольник,\n");
    printf("у которого две стороны равны, а углы при основании равны.\n");

    for (i = 1; i <= a; i++)
    {
        left = left + 1;
        right = right + 1;
    }

    printf("Символов на левой стороне: %d\n", left);
    printf("Символов на правой стороне: %d\n", right);
    printf("Символов на основании: %d\n", bottom);

    if (left == right)
    {
        printf("треугольник равнобедренный\n");
    }
    else
    {
        printf("треугольник не равнобедренный\n");
    }
}

/* Рисование равнобедренного треугольника символом symbol.
   a - боковая сторона (число строк), b - основание (символов в последней строке).
   Первая строка: 1 символ, последняя: b символов, между ними ширина растет равномерно. */
void draw_triangle(int a, int b, char symbol)
{
    int i, j, w;

    for (i = 1; i <= a; i++)
    {
        if (a == 1)
        {
            w = b;
        }
        else
        {
            /* w = 1 + округление((b-1)*(i-1)/(a-1)) в целых числах */
            w = 1 + (2 * (b - 1) * (i - 1) + (a - 1)) / (2 * (a - 1));
        }

        /* отступ: символ вместе с пробелом занимает 2 позиции,
           поэтому строка из w символов центрируется отступом b - w */
        for (j = 1; j <= b - w; j++)
        {
            printf(" ");
        }
        for (j = 1; j <= w; j++)
        {
            printf("%c ", symbol);
        }
        printf("\n");
    }
}

int main()
{
    int choice;
    int s1, s2, s3;
    int a, b;
    int ok;
    char symbol;

    printf("Фигура: равнобедренный треугольник\n");

    do
    {
        ok = 1;

        printf("Введите первую сторону (целое число): ");
        scanf("%d", &s1);
        printf("Введите вторую сторону (целое число): ");
        scanf("%d", &s2);
        printf("Введите третью сторону (целое число): ");
        scanf("%d", &s3);

        if (!triangle_exists(s1, s2, s3))
        {
            printf("Треугольник с такими сторонами не существует! Введите заново.\n");
            ok = 0;
        }
        else if (s1 != s2 && s1 != s3 && s2 != s3)
        {
            printf("Две стороны должны быть равны! Введите заново.\n");
            ok = 0;
        }
    } while (!ok);

    /* определяем боковую сторону a и основание b */
    if (s1 == s2)
    {
        a = s1;
        b = s3;
    }
    else if (s1 == s3)
    {
        a = s1;
        b = s2;
    }
    else
    {
        a = s2;
        b = s1;
    }

    printf("Введите символ для рисования: ");
    scanf(" %c", &symbol);

    printf("Боковая сторона a = %d, основание b = %d\n", a, b);

    do
    {
        printf("\nМеню:\n");
        printf("1) Рассчитать площадь\n");
        printf("2) Вывести определение фигуры\n");
        printf("3) Нарисовать фигуру\n");
        printf("0) Выход\n");
        printf("Ваш выбор: ");
        scanf("%d", &choice);

        if (choice == 1)
        {
            printf("Площадь = %.2f\n", area_triangle(a, a, b));
        }
        else if (choice == 2)
        {
            print_definition(a, b);
        }
        else if (choice == 3)
        {
            draw_triangle(a, b, symbol);
        }
        else if (choice != 0)
        {
            printf("Неверный пункт меню!\n");
        }
    } while (choice != 0);

    return 0;
}
